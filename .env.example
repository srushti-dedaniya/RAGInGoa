# =====================================================================
# RAGInGoa — root-level env example
# Copy to .env at the repo root, or (better) use the per-component ones.
# =====================================================================

# --- Backend ---
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_LANGUAGE_CODE=unknown
STT_ROUTER=sarvam
LLM_ROUTER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
DATASET_PATH=rag/data/processed/msmarco_xi.jsonl
DATASET_LANGUAGE=hi
DATASET_SPLIT=validation
DATASET_MAX_RECORDS=5000
VECTOR_DB_PATH=rag/vector_db/index
CHUNKING_STRATEGY=sentence
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=4
SIMILARITY_THRESHOLD=0.25
REQUIRE_INDEX=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
