# =====================================================================
# RAGInGoa — root-level env example
# Copy to .env at the repo root, or (better) use the per-component ones.
# =====================================================================

# --- Backend ---
OPENAI_API_KEY=
VECTOR_DB_ROUTER=dev                      # dev | milvus | qdrant | chromadb
STT_ROUTER=dev                            # dev | whisper
LLM_ROUTER=dev                            # dev | openai
VECTOR_DB_URL=http://localhost:19530
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=4
BENCHMARK_TOP_K=4
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000