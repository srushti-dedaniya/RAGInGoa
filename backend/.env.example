# =====================================================================
# RAGInGoa backend environment (copy to `.env` and fill in)
# =====================================================================

# --- Routers ---
# dev   : offline, deterministic, no keys required (great for demos)
# whisper: OpenAI Whisper API for STT (requires OPENAI_API_KEY)
STT_ROUTER=dev
LLM_ROUTER=dev
VECTOR_DB_ROUTER=dev

# --- Provider keys (leave blank for dev mode) ---
OPENAI_API_KEY=

# --- Vector store ---
VECTOR_DB_URL=http://localhost:19530
VECTOR_DB_COLLECTION=ragingoa

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Chunking ---
CHUNK_STRATEGY=sentence
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# --- Retrieval / generation ---
TOP_K=4
BENCHMARK_TOP_K=4
SCORE_THRESHOLD=0.0
RERANK=false

# --- Paths (relative to repo root) ---
INDEX_DIR=rag/vector_db/index
PROCESSED_DATA_DIR=rag/data/processed
SAMPLE_DATA_PATH=rag/data/samples/sample_goa_docs.jsonl

# --- HTTP ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PORT=8000