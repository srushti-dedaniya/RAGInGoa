SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_STT_MODEL=saaras:v3
SARVAM_LANGUAGE_CODE=unknown
LLM_ROUTER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EXTERNAL_TIMEOUT_SECONDS=20
EXTERNAL_MAX_RETRIES=2

EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
VECTOR_DB_PATH=rag/vector_db/index
DATASET_PATH=rag/data/processed/msmarco_xi.jsonl
DATASET_LANGUAGE=hi
DATASET_SPLIT=validation
DATASET_MAX_RECORDS=5000
CHUNKING_STRATEGY=sentence
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=4
SIMILARITY_THRESHOLD=0.25
RERANK=false
REQUIRE_INDEX=true
