STT_ROUTER=sarvam
SARVAM_API_KEY=
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_STT_MODEL=saaras:v3
SARVAM_LANGUAGE_CODE=unknown
LLM_ROUTER=sarvam
LLM_MODEL=sarvam-105b
EXTERNAL_TIMEOUT_SECONDS=20
EXTERNAL_MAX_RETRIES=2

EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
VECTOR_DB_ROUTER=faiss
DEFAULT_LANGUAGE=en-IN
VECTOR_DB_PATH=rag/vector_db/index/en
VECTOR_DB_PATH_EN=rag/vector_db/index/en
VECTOR_DB_PATH_HI=rag/vector_db/index/hi
VECTOR_DB_PATH_MR=rag/vector_db/index/mr
DATASET_PATH=rag/data/processed/msmarco_xi_en.jsonl
DATASET_PATH_EN=rag/data/processed/msmarco_xi_en.jsonl
DATASET_PATH_HI=rag/data/processed/msmarco_xi_hi.jsonl
DATASET_PATH_MR=rag/data/processed/msmarco_xi_mr.jsonl
DATASET_LANGUAGE=en
DATASET_SPLIT=validation
DATASET_MAX_RECORDS=1000
CHUNKING_STRATEGY=sentence
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=4
SIMILARITY_THRESHOLD=0.45
RERANK=false
REQUIRE_INDEX=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
PORT=8000
