# Copy to `.env` and adjust.
# Publicly-bundled vars must be prefixed with VITE_.
VITE_API_BASE_URL=http://localhost:8000
# When true, the app never calls the network and plays canned demo responses.
VITE_USE_DEMO=false
# Set the default example query shown in the query workspace.
VITE_DEMO_QUERY=What is the best time to visit Palolem in Goa?
